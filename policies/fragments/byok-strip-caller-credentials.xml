<fragment>
  <choose>
    <when condition="@(!context.Variables.ContainsKey(&quot;byokCallerAuthenticated&quot;) || !(bool)context.Variables[&quot;byokCallerAuthenticated&quot;])">
      <return-response>
        <set-status code="401" reason="Caller authentication required" />
        <set-header name="Content-Type" exists-action="override"><value>application/json</value></set-header>
        <set-body>{"error":{"code":"CallerAuthenticationRequired","message":"Caller validation must precede backend access."}}</set-body>
      </return-response>
    </when>
  </choose>
  <set-header name="api-key" exists-action="delete" />
  <set-header name="x-api-key" exists-action="delete" />
  <set-header name="Authorization" exists-action="delete" />
  <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
  <set-query-parameter name="api-key" exists-action="delete" />
  <set-query-parameter name="subscription-key" exists-action="delete" />
  <set-query-parameter name="x-api-key" exists-action="delete" />
  <set-query-parameter name="Authorization" exists-action="delete" />
  <set-query-parameter name="access_token" exists-action="delete" />
  <set-variable name="byokJwtToken" value="" />
</fragment>