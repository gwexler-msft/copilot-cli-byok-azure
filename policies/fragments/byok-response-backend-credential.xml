<fragment>
  <set-variable name="byokResponseBackendCredential" value="" />
  <set-variable name="byokResponseBackendCredentialHeader" value="Authorization" />
  <set-variable name="byokResponseBackendToken" value="" />
  <choose>
    <when condition="@((string)context.Variables[&quot;byokResponseBackendKind&quot;] == &quot;foundry&quot;)">
      <authentication-managed-identity resource="{{foundry-mi-audience}}" output-token-variable-name="byokResponseBackendToken" ignore-error="true" />
      <set-variable name="byokResponseBackendCredential" value="@(string.IsNullOrWhiteSpace((string)context.Variables[&quot;byokResponseBackendToken&quot;]) ? &quot;&quot; : &quot;Bearer &quot; + (string)context.Variables[&quot;byokResponseBackendToken&quot;])" />
    </when>
    <when condition="@((string)context.Variables[&quot;byokResponseBackendKind&quot;] == &quot;aoai&quot;)">
      <authentication-managed-identity resource="{{aoai-mi-audience}}" output-token-variable-name="byokResponseBackendToken" ignore-error="true" />
      <set-variable name="byokResponseBackendCredential" value="@(string.IsNullOrWhiteSpace((string)context.Variables[&quot;byokResponseBackendToken&quot;]) ? &quot;&quot; : &quot;Bearer &quot; + (string)context.Variables[&quot;byokResponseBackendToken&quot;])" />
    </when>
    <when condition="@((string)context.Variables[&quot;byokResponseBackendKind&quot;] == &quot;commercial&quot;)">
      <choose>
        <when condition="@(&quot;{{foundry-commercial-auth-mode}}&quot;.Equals(&quot;managedIdentity&quot;, StringComparison.OrdinalIgnoreCase))">
          <authentication-managed-identity resource="{{foundry-commercial-mi-audience}}" output-token-variable-name="byokResponseBackendToken" ignore-error="true" />
          <set-variable name="byokResponseBackendCredential" value="@(string.IsNullOrWhiteSpace((string)context.Variables[&quot;byokResponseBackendToken&quot;]) ? &quot;&quot; : &quot;Bearer &quot; + (string)context.Variables[&quot;byokResponseBackendToken&quot;])" />
        </when>
        <when condition="@(&quot;{{foundry-commercial-auth-mode}}&quot;.Equals(&quot;apikey&quot;, StringComparison.OrdinalIgnoreCase))">
          <set-variable name="byokResponseBackendCredentialHeader" value="api-key" />
          <set-variable name="byokResponseBackendCredential" value="{{foundry-commercial-api-key}}" />
        </when>
        <when condition="@(&quot;{{foundry-commercial-auth-mode}}&quot;.Equals(&quot;servicePrincipal&quot;, StringComparison.OrdinalIgnoreCase) || &quot;{{foundry-commercial-auth-mode}}&quot;.Equals(&quot;servicePrincipalFederated&quot;, StringComparison.OrdinalIgnoreCase))">
          <set-variable name="byokResponseFederationAssertion" value="" />
          <choose>
            <when condition="@(&quot;{{foundry-commercial-auth-mode}}&quot;.Equals(&quot;servicePrincipalFederated&quot;, StringComparison.OrdinalIgnoreCase))">
              <authentication-managed-identity resource="api://AzureADTokenExchange" output-token-variable-name="byokResponseFederationAssertion" ignore-error="true" />
            </when>
          </choose>
          <send-request mode="new" response-variable-name="byokResponseCommercialToken" timeout="15" ignore-error="true">
            <set-url>@("https://{{foundry-commercial-authority-host}}/{{foundry-commercial-tenant-id}}/oauth2/v2.0/token")</set-url>
            <set-method>POST</set-method>
            <set-header name="Content-Type" exists-action="override"><value>application/x-www-form-urlencoded</value></set-header>
            <set-body>@{
              var content = "grant_type=client_credentials&amp;client_id=" + Uri.EscapeDataString("{{foundry-commercial-client-id}}")
                  + "&amp;scope=" + Uri.EscapeDataString("{{foundry-commercial-token-resource}}".TrimEnd('/') + "/.default");
              if ("{{foundry-commercial-auth-mode}}".Equals("servicePrincipalFederated", StringComparison.OrdinalIgnoreCase)) {
                return content + "&amp;client_assertion_type=" + Uri.EscapeDataString("urn:ietf:params:oauth:client-assertion-type:jwt-bearer")
                    + "&amp;client_assertion=" + Uri.EscapeDataString((string)context.Variables["byokResponseFederationAssertion"]);
              }
              return content + "&amp;client_secret=" + Uri.EscapeDataString("{{foundry-commercial-client-secret}}");
            }</set-body>
          </send-request>
          <set-variable name="byokResponseBackendCredential" value="@{
            try {
              var response = context.Variables.ContainsKey(&quot;byokResponseCommercialToken&quot;) ? (IResponse)context.Variables[&quot;byokResponseCommercialToken&quot;] : null;
              if (response == null || response.StatusCode != 200) { return &quot;&quot;; }
              var token = (string)response.Body.As&lt;Newtonsoft.Json.Linq.JObject&gt;()[&quot;access_token&quot;];
              return string.IsNullOrWhiteSpace(token) ? &quot;&quot; : &quot;Bearer &quot; + token;
            } catch { return &quot;&quot;; }
          }" />
          <set-variable name="byokResponseCommercialToken" value="" />
          <set-variable name="byokResponseFederationAssertion" value="" />
        </when>
      </choose>
    </when>
  </choose>
  <set-variable name="byokResponseBackendToken" value="" />
</fragment>