// | where timestamp > ago(24h)
// | where name in ("Prompt Tokens", "Completion Tokens", "Total Tokens", "copilot_byok_request")
// | extend
//     Developer    = tostring(customDimensions["User ID"]),
//     Subscription = tostring(customDimensions["Subscription ID"]),
//     Model        = tostring(customDimensions["Model"]),
//     Operation    = tostring(customDimensions["Operation ID"])
// | summarize
//     PromptTokens     = sumif(value, name == "Prompt Tokens"),
//     CompletionTokens = sumif(value, name == "Completion Tokens"),
//     TotalTokens      = sumif(value, name == "Total Tokens"),
//     Requests         = sumif(value, name == "copilot_byok_request")
//   by Developer, Subscription, Model, Operation
// | where Requests > 0
// | order by Subscription asc, TotalTokens desc

