    "environmentName": { "value": "<private-container-apps-environment>" },
    "environmentIngressMode": { "value": "internal" },
    "environmentResourceGroup": { "value": "<environment-resource-group>" },
    "apimResourceGroup": { "value": "<apim-resource-group>" },
    "apimName": { "value": "<apim-name>" },
    "apimPrivateIp": { "value": "<apim-private-ip>" },
    "apimGatewayHost": { "value": "<apim-gateway-host>" },
    "intellijApiPath": { "value": "intellij" },
    "configureApim": { "value": false },
    "configurePrivateDns": { "value": false },
    "maxReplicas": { "value": 3 }
  }
